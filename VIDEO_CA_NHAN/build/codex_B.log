import sys,io,math,re
sys.dont_write_bytecode=True
from pathlib import Path
from PIL import Image,ImageDraw,ImageFont
from pptx import Presentation
from pptx.enum.shapes import MSO_SHAPE_TYPE
from pptx.enum.dml import MSO_FILL_TYPE
S=144
F=Path('C:/Windows/Fonts')
def px(n): return round(n/914400*S)
def color(obj,default='0F172A'):
 try: return '#'+str(obj.rgb)
 except: return '#'+default

def font(run):
 name=run.font.name or 'Calibri'
 stem={'Calibri':'calibri','Trebuchet MS':'trebuc','Consolas':'consola'}.get(name,'calibri')
 bold,ital=run.font.bold,run.font.italic
 suffix=('z' if bold and ital else 'b' if bold else 'i' if ital else '')
 if stem=='trebuc' and bold: suffix='bd'
 file=F/(stem+suffix+'.ttf')
 if not file.exists(): file=F/(stem+'.ttf')
 return ImageFont.truetype(str(file),round((run.font.size.pt if run.font.size else 20)*2))

def render_text(draw,tf,box,anchor=1):
 x,y,w,h=box
 x+=px(tf.margin_left);y+=px(tf.margin_top)
 w-=px(tf.margin_left+tf.margin_right)
 lines=[]
 for p in tf.paragraphs:
  line=[];width=0;maxheight=0
  for run in p.runs:
   face=font(run)
   for word in re.findall(r'\\S+\\s*|\\n',run.text):
    width_word=draw.textlength(word,font=face)
    if width and width+width_word>w:
     lines.append((line,width,maxheight,p));line=[];width=0;maxheight=0
    line.append((word,face,color(run.font.color)));width+=width_word
    maxheight=max(maxheight,face.size*1.08)
  lines.append((line,width,maxheight or 40,p))
  lines.append(([],0,p.space_after.pt*2 if p.space_after else 0,p))
 total=sum(l[2] for l in lines)
 if anchor==3: y+=max(0,(h-total)/2)
 for line,width,height,p in lines:
  left=x+max(0,w-width) if p.alignment==3 else x+max(0,(w-width)/2) if p.alignment==2 else x
  for word,face,fill in line:
   draw.text((left,y),word,font=face,fill=fill,anchor='lt')
   left+=draw.textlength(word,font=face)
  y+=height

for folder in sorted(Path('VIDEO_CA_NHAN').glob('Nguoi_*')):
 out=folder/'output'/'preview_fallback';out.mkdir(exist_ok=True)
 prs=Presentation(folder/'output'/f'{folder.name[:7]}_slides.pptx')
 thumbs=[]
 for n,slide in enumerate(prs.slides,1):
  im=Image.new('RGB',(1920,1080),color(slide.background.fill.fore_color,'F8FAFC'));d=ImageDraw.Draw(im)
  for sh in slide.shapes:
   x,y,w,h=map(px,(sh.left,sh.top,sh.width,sh.height))
   if sh.shape_type==MSO_SHAPE_TYPE.PICTURE:
    pic=Image.open(io.BytesIO(sh.image.blob)).convert('RGB').resize((w,h),Image.Resampling.LANCZOS);im.paste(pic,(x,y))
   elif sh.has_table:
    cy=y
    for i,row in enumerate(sh.table.rows):
     cx=x
     for j,cell in enumerate(row.cells):
      cw,ch=px(sh.table.columns[j].width),px(row.height)
      d.rectangle((cx,cy,cx+cw,cy+ch),fill=color(cell.fill.fore_color,'FFFFFF'),outline='#FFFFFF',width=1)
      render_text(d,cell.text_frame,(cx,cy,cw,ch),3)
      cx+=cw
     cy+=px(row.height)
   else:
    try:
     if sh.fill.type==MSO_FILL_TYPE.SOLID:
      fill=color(sh.fill.fore_color,'F8FAFC')
      d.rounded_rectangle((x,y,x+w,y+h),radius=12 if sh.auto_shape_type==5 else 0,fill=fill)
    except: pass
    if sh.has_text_frame: render_text(d,sh.text_frame,(x,y,w,h))
  im.save(out/f'slide_{n:02}.png')
  thumb=im.resize((640,360));td=ImageDraw.Draw(thumb);td.text((5,342),f'{folder.name[:7]} slide {n} | approximate, not Office',fill='#D97706',font=ImageFont.truetype(str(F/'calibri.ttf'),14));thumbs.append(thumb)
 sheet=Image.new('RGB',(1920,1080),'white')
 for i,thumb in enumerate(thumbs): sheet.paste(thumb,((i%3)*640,(i//3)*360))
 sheet.save(out/'contact_sheet.png')
 print(out,'9 fallback previews')
