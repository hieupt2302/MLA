diff --git a/VIDEO_CA_NHAN/build/build_script_docx.py b/VIDEO_CA_NHAN/build/build_script_docx.py
new file mode 100644
index 0000000000000000000000000000000000000000..9dad68b8c767493070f93efd034ba278ce171e6b
--- /dev/null
+++ b/VIDEO_CA_NHAN/build/build_script_docx.py
@@ -0,0 +1,58 @@
+"""Create teleprompter documents from the spoken-script sections."""
+import sys
+sys.dont_write_bytecode = True
+import argparse
+import re
+from docx import Document
+from docx.shared import Cm, Pt, RGBColor
+from build_pptx import people, sections, plain
+
+
+def build(folder):
+    path = folder / '01_SCRIPT_EN.md'
+    doc = Document()
+    sec = doc.sections[0]
+    sec.page_width, sec.page_height = Cm(21), Cm(29.7)
+    sec.top_margin = sec.bottom_margin = sec.left_margin = sec.right_margin = Cm(2)
+    normal = doc.styles['Normal']
+    normal.font.name, normal.font.size = 'Calibri', Pt(16)
+    normal.paragraph_format.line_spacing = 1.4
+    normal.paragraph_format.space_after = Pt(10)
+    doc.add_heading(path.read_text(encoding='utf-8-sig').splitlines()[0].lstrip('# '), 0)
+    words = []
+    for heading, body in sections(path):
+        p = doc.add_heading(heading, 1)
+        p.paragraph_format.keep_with_next = True
+        for r in p.runs:
+            r.font.name, r.font.size, r.font.bold = 'Calibri', Pt(17), True
+            r.font.color.rgb = RGBColor.from_string('0F172A')
+        for block in re.split(r'\n\s*\n', body):
+            # A direction remains a separate paragraph even without a blank line.
+            for part in re.split(r'(?m)(?=^>)|(?<=\n)(?!>)', block) if block.startswith('>') else [block]:
+                if not part.strip():
+                    continue
+                stage = part.startswith('>')
+                text = re.sub(r'(?m)^>\s*', '', part).strip() if stage else part.strip()
+                if not stage:
+                    words.extend(re.findall(r"\b[\w]+(?:['’−.-][\w]+)*\b", plain(text)))
+                p = doc.add_paragraph()
+                for token in re.split(r'(`[^`]+`|\*[^*]+\*|\[tự điền:[^\]]*\])', text):
+                    code, emphasis = token.startswith('`'), token.startswith('*')
+                    r = p.add_run(token[1:-1] if code or emphasis else token)
+                    r.font.name, r.font.size = 'Consolas' if code else 'Calibri', Pt(12 if stage else 16)
+                    r.italic = stage or emphasis
+                    r.font.color.rgb = RGBColor.from_string('D97706' if token.startswith('[tự điền:') else ('64748B' if stage else '0F172A'))
+    duration = len(words) / 140
+    doc.add_paragraph(f'Spoken word count: {len(words):,} · Estimated duration at 140 wpm: {int(duration)}:{round(duration % 1 * 60):02d}')
+    out = folder / 'output' / f'{folder.name[:7]}_script.docx'
+    out.parent.mkdir(exist_ok=True)
+    doc.save(out)
+    assert len(Document(out).paragraphs) == len(doc.paragraphs)
+    print(f'{out} — {len(words)} words, {duration:.2f} minutes')
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--person', choices=['1', '2', '3'])
+    for folder in people(parser.parse_args().person):
+        build(folder)
diff --git a/VIDEO_CA_NHAN/build/check_numbers.py b/VIDEO_CA_NHAN/build/check_numbers.py
new file mode 100644
index 0000000000000000000000000000000000000000..d00666fcd08cd5a16106ca66a132614c49788391
--- /dev/null
+++ b/VIDEO_CA_NHAN/build/check_numbers.py
@@ -0,0 +1,109 @@
+"""Report displayed numbers absent from the approved saved evidence (never a gate)."""
+import csv
+import json
+import math
+import re
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+VIDEO = ROOT / 'VIDEO_CA_NHAN'
+NUMBER = re.compile(r'(?<![\w.])([+−-]?(?:\d{1,3}(?:,\d{3})+|\d+)(?:\.\d+)?)(%?)(?!\w|\.\d|,\d)')
+
+
+def scrub(line):
+    line = re.sub(r'\b\d{4}-\d{2}-\d{2}(?:T[\d:]+(?:Z)?)?', '', line)
+    line = re.sub(r'\b\d{1,2}/\d{1,2}/\d{4}\b|\b\d{1,2}:\d{2}\b', '', line)
+    line = re.sub(r'\b(?:Slide|SLIDE)\s+\d+\b|\b2026\b', '', line)
+    line = re.sub(r'\b\d{1,2}\s+(?:Oct(?:ober)?|Nov(?:ember)?)\b', '', line)
+    return line
+
+
+def tokens(line):
+    for m in NUMBER.finditer(scrub(line)):
+        token = m[1].replace(',', '').replace('−', '-')
+        precision = len(token.split('.')[1]) if '.' in token else 0
+        percent = bool(m[2]) or bool(re.match(r'\s*(?:percent\b|–\d+(?:\.\d+)?%)', scrub(line)[m.end():]))
+        yield m[0], float(token), precision, percent
+
+
+def known_values():
+    values = set()
+    paths = sorted((ROOT / 'MLA_Final/Results/tables').glob('*.csv'))
+    paths += [ROOT / 'MLA_Final/Results/predictions/context_levels_10_cases.csv']
+    paths += sorted((ROOT / 'VAN_DAP_4_TIEU_CHI/trace_mau_that/outputs').glob('*.csv'))
+    def add(value):
+        if isinstance(value, bool) or value is None:
+            return
+        if isinstance(value, (int, float)):
+            if math.isfinite(value):
+                values.add(float(value))
+        elif isinstance(value, dict):
+            for child in value.values():
+                add(child)
+        elif isinstance(value, list):
+            for child in value:
+                add(child)
+        elif isinstance(value, str):
+            for _, number, _, percent in tokens(value):
+                values.add(number / 100 if percent else number)
+    for path in paths:
+        if path.is_file():
+            with path.open(encoding='utf-8-sig', newline='') as stream:
+                for row in csv.reader(stream):
+                    for cell in row:
+                        add(cell)
+    configs = sorted((ROOT / 'MLA_Final/Code/configs').glob('*.json'))
+    reports = sorted((ROOT / 'final_report/report_src').glob('*.md'))
+    for path in configs:
+        add(json.loads(path.read_text(encoding='utf-8-sig')))
+    for path in reports:
+        add(path.read_text(encoding='utf-8-sig'))
+    assert paths and configs and reports and values, 'Evidence inputs are missing'
+    return values, len(paths) + len(configs) + len(reports)
+
+
+def run():
+    values, count = known_values()
+    cache = {}
+    def verified(value, precision, percent):
+        key = precision, percent
+        if key not in cache:
+            # Percentage/fraction equivalence is symmetric, including explicit % evidence.
+            cache[key] = {round(v * scale, precision) for v in values for scale in (1, 100, .01)}
+        return round(value, precision) in cache[key]
+    assert verified(.577, 3, False) or round(.5772, 3) == .577
+    assert list(tokens('1:15–2:45 Slide 4 2026 −0.092 144,289')) == [('−0.092', -.092, 3, False), ('144,289', 144289., 0, False)]
+    print(f'Known evidence: {len(values):,} distinct numeric values from {count} files.')
+    for folder in sorted(VIDEO.glob('Nguoi_*')):
+        runbook = (folder / '03_DEMO_RUNBOOK.md').read_text(encoding='utf-8-sig')
+        expected = re.search(r'## Output[^\n]*\n(.*?)(?=\n## |\Z)', runbook, re.S)
+        demo = list(tokens(expected[1] if expected else ''))
+        general, demo_only, total = [], [], 0
+        for filename in ('01_SCRIPT_EN.md', '02_SLIDE_SPEC.md'):
+            for line_no, line in enumerate((folder / filename).read_text(encoding='utf-8-sig').splitlines(), 1):
+                for display, value, precision, percent in tokens(line):
+                    total += 1
+                    if not verified(value, precision, percent):
+                        row = f'{filename}:{line_no} | {display} | {line.strip()}'
+                        target = demo_only if any(round(v, precision) == round(value, precision) for _, v, _, _ in demo) else general
+                        target.append(row)
+        lines = [f'{folder.name}: {total} tokens; {total-len(general)-len(demo_only)} verified; '
+                 f'{len(general)+len(demo_only)} unverified occurrences.',
+                 '', 'UNVERIFIED — absent from approved evidence', 'File:line | Number | Context', *general,
+                 '', 'UNVERIFIED — also present in runbook expected output (demo-derived candidates)',
+                 'File:line | Number | Context', *demo_only]
+        if not general:
+            lines.insert(4, '(none)')
+        if not demo_only:
+            lines.append('(none)')
+        report = '\n'.join(lines) + '\n'
+        out = folder / 'output'
+        out.mkdir(exist_ok=True)
+        (out / 'number_check.txt').write_text(report, encoding='utf-8')
+        print('\n' + report)
+
+
+if __name__ == '__main__':
+    sys.stdout.reconfigure(encoding='utf-8')
+    run()
