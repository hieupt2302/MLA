import numpy as np
from sklearn.metrics import f1_score

def main():
    parser = argparse.ArgumentParser(description=\"Saved L0/L1 inputs and validation flag threshold.\")
    parser.add_argument(\"--no-raw\", action=\"store_true\")
    parser.add_argument(\"--theta\", type=float, default=.10)
    args = parser.parse_args()
    if not 0 <= args.theta <= 1:
        parser.error(\"theta must lie between 0 and 1\")
    raw = data.raw_optional(\"train\", args.no_raw)
    e, l0, l1 = data.inputs_case8(raw)
    print(f\"① CASE 8  validation row_idx {int(e['row_idx']):,} | {e['discourse_type']}\")
    print(f\"   {e['prompt_name']} | gold {data.LABELS[int(e['label'])]}\")
    if raw is None:
        print(\"   Note: target excerpt from saved table D7 (neighbour text needs raw CSV).\")
    for model, text in [(\"L0\",l0),(\"L1\",l1)]:
        data.print_wrapped(f\"   {model} input: {text}\")
        r = data.probability_row(\"val\",model,e['row_idx'])
        print(f\"   {model} (locked) P(Ineff/Adeq/Eff) = {data.probability_text(r)}\"
              f\" -> {data.LABELS[int(r.pred_label)]}\")
    df = data.predictions(\"val\",\"L1\")
    p = df[[f\"pred_proba_{i}\" for i in range(3)]].to_numpy()
    y = df.true_label.to_numpy()
    base = p.argmax(axis=1)
    selected = np.where(p[:,0] >= args.theta, 0, p[:,1:].argmax(axis=1)+1)
    print(\"\\\\n② FLAG IF P(Ineffective) >= θ   (locked L1, validation)\")
    print(f\"   {len(df):,} units, {int((y == 0).sum()):,} gold Ineffective\")
    print(\"   rule          flagged   recall   precision   Macro-F1\")
    stats = []
    for name,pred in [(\"argmax\",base),(f\"θ={args.theta:.2f}\",selected)]:
        flagged = int((pred == 0).sum()); tp = int(((pred == 0)&(y == 0)).sum())
        recall = tp / (y == 0).sum(); precision = tp/flagged if flagged else 0
        print(f\"   {name:<12} {flagged:>7,}   {recall:>6.1%}      {precision:>6.1%}      \"
              f\"{f1_score(y,pred,labels=[0,1,2],average='macro',zero_division=0):.3f}\")
        stats.append((tp,flagged-tp))
    extra = stats[1][0]-stats[0][0]; false = stats[1][1]-stats[0][1]
    print(f\"   extra correct flags: {extra:,} | extra false alarms: {false:,}\")
    print(f\"   false alarms per extra catch: {false/extra:.1f}\" if extra > 0
          else \"   false alarms per extra catch: n/a (no net extra catches)\")
    r = data.probability_row(\"val\",\"L1\",e['row_idx'])
    flagged = r.pred_proba_0 >= args.theta
    print(f\"\\\\n③ case 8: P(Ineffective) = {r.pred_proba_0:.3f} \"
          f\"{'≥' if flagged else '<'} θ = {args.theta:.2f} -> {'flagged' if flagged else 'not flagged'}\")
''', '''
import hashlib
from sklearn.metrics import f1_score

def main():
    parser = argparse.ArgumentParser(description=\"Check test lock and saved prediction metrics.\")
    parser.add_argument(\"--no-raw\",action=\"store_true\")
    args = parser.parse_args()
    lock = data.lock()
    print(f\"① TEST LOCK   locked_at {lock['locked_at']}\")
    print(f\"   n_test {lock['n_test']:,}\")
    print(f\"   sha256 (lock) {lock['test_sha256'][:16]}…\")
    path = data.raw_path(\"test\")
    if args.no_raw or not path.exists():
        print(\"   Note: optional raw test CSV unavailable/skipped; hash check not performed.\")
    else:
        try:
            sha = hashlib.sha256()
            with path.open('rb') as f:
                for chunk in iter(lambda: f.read(8*1024*1024),b''):
                    sha.update(chunk)
            actual = sha.hexdigest()
            print(f\"   sha256 (now)  {actual[:16]}… -> matches lock: {actual == lock['test_sha256']}\")
            print(\"   (labels not read)\")
        except OSError as exc:
            print(f\"   Note: optional hash check unavailable ({type(exc).__name__}).\")
    print(\"\\\\n② TEST MACRO-F1 RECOMPUTED FROM SAVED PREDICTIONS\")
    print(\"   model                       units   recomputed   paper (R2)\")
    for key,name in [(\"L0\",\"DeBERTa L0\"),(\"L1\",\"DeBERTa L1 (locked)\"),(\"PA\",\"DeBERTa Prompt-Aware\")]:
        df = data.predictions(\"test\",key)
        assert len(df) == lock['n_test']
        value = f1_score(df.true_label,df.pred_label,labels=[0,1,2],average='macro')
        r2 = data.table(\"R2_test_per_class.csv\")
        paper = r2[r2.system.str.contains(\"Prompt-Aware\" if key == 'PA' else key)].iloc[0].macro_f1
        print(f\"   {name:<25} {len(df):>7,}      {value:.4f}      {paper:.4f}\")
    r8 = data.table(\"R8_ten_cases.csv\").query('case == 2').iloc[0]
    print(f\"\\\\n③ CASE {r8['case']}  validation row_idx {r8.row_idx:,} | {r8['type']}\")
    print(f\"   {r8.prompt} | gold {r8.gold}\")
    print(\"   level                  P(Ineffective)   prediction\")
    row = data.ladder()
    names = {'Ineff':'Ineffective','Adeq':'Adequate','Eff':'Effective'}
    for key,name in data.LEVELS:
        print(f\"   {name:<24} {row[f'P_ineff_{key}']:.3f}          {names[row[f'pred_{key}']]}\")
    print(\"\\\\n④ LOPO GAP (same validation essays; LOPO minus in-domain Macro-F1)\")
    r5 = data.table('R5_lopo_vs_indomain_per_class.csv')
    for prompt, group in r5.groupby('held_out_prompt',sort=False):
        lopo = group[group.setting.str.startswith('LOPO') & group.setting.str.contains('validation essays')].iloc[0]
        domain = group[group.setting.str.startswith('In-domain')].iloc[0]
        print(f\"   {prompt}: {lopo.macro_f1 - domain.macro_f1:+.3f}\")
''']
